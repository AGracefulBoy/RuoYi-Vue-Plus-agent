    <sql id="selectSysColumnMetadataVo">
        select scm.column_meta_id, scm.tenant_id, scm.table_meta_id, scm.datasource_id,
               sd.datasource_name, scm.database_name, scm.table_name, scm.column_name,
               scm.column_comment, scm.ordinal_position, scm.column_default, scm.is_nullable,
               scm.data_type, scm.character_maximum_length, scm.numeric_precision, scm.numeric_scale,
               scm.datetime_precision, scm.character_set_name, scm.collation_name, scm.column_type,
               scm.column_key, scm.extra, scm.is_primary_key, scm.is_foreign_key, scm.is_unique_key,
               scm.is_indexed, scm.foreign_key_table, scm.foreign_key_column, scm.business_name,
               scm.business_description, scm.data_classification, scm.sensitivity_level, scm.is_pii,
               scm.masking_rule, scm.validation_rule, scm.sample_values, scm.sync_status,
               scm.last_sync_time, scm.status, scm.remark, scm.create_by,
               u1.nick_name as createByName, scm.create_time, scm.update_by,
               u2.nick_name as updateByName, scm.update_time
        from sys_column_metadata scm
        left join sys_datasource sd on scm.datasource_id = sd.datasource_id
        left join sys_user u1 on scm.create_by = u1.user_id
        left join sys_user u2 on scm.update_by = u2.user_id
    </sql>

