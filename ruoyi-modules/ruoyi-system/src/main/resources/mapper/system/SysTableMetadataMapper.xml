    <resultMap type="org.dromara.system.domain.vo.SysTableMetadataVo" id="SysTableMetadataVoResult">
        <result property="tableMetaId" column="table_meta_id" />
        <result property="tenantId" column="tenant_id" />
        <result property="datasourceId" column="datasource_id" />
        <result property="datasourceName" column="datasource_name" />
        <result property="databaseName" column="database_name" />
        <result property="tableName" column="table_name" />
        <result property="tableComment" column="table_comment" />
        <result property="tableDesc" column="table_desc" />
        <result property="tableType" column="table_type" />
        <result property="engine" column="engine" />
        <result property="charset" column="charset" />
        <result property="collation" column="collation" />
        <result property="tableRows" column="table_rows" />
