        <result property="updateByName" column="updateByName" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectSysTableMetadataVo">
        select stm.table_meta_id, stm.tenant_id, stm.datasource_id, sd.datasource_name,
               stm.database_name, stm.table_name, stm.table_comment, stm.table_desc, stm.table_type,
               stm.engine, stm.charset, stm.collation, stm.table_rows,
               stm.data_length, stm.index_length, stm.create_time_db, stm.update_time_db,
               stm.sync_status, stm.last_sync_time, stm.sync_error_message, stm.field_count,
               stm.index_count, stm.is_partitioned, stm.partition_info, stm.table_structure,
               stm.business_description, stm.status, stm.remark, stm.create_by,
               u1.nick_name as createByName, stm.create_time, stm.update_by,
               u2.nick_name as updateByName, stm.update_time
        from sys_datasource_table_metadata stm
        left join sys_datasource sd on stm.datasource_id = sd.datasource_id
        left join sys_user u1 on stm.create_by = u1.user_id
        left join sys_user u2 on stm.update_by = u2.user_id
    </sql>

    <!-- 由于使用了注解方式，大部分SQL已在Mapper接口中定义，此处仅保留基本的映射配置 -->

</mapper>
