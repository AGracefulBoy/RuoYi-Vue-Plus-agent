<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.system.mapper.SysAgentChatGroupMapper">

    <resultMap type="org.dromara.system.domain.vo.ChatGroupVo" id="ChatGroupVoResult">
        <result property="groupId"       column="group_id"/>
        <result property="userId"        column="user_id"/>
        <result property="groupName"     column="group_name"/>
        <result property="parentId"      column="parent_id"/>
        <result property="icon"          column="icon"/>
        <result property="color"         column="color"/>
        <result property="sortOrder"     column="sort_order"/>
        <result property="isDefault"     column="is_default"/>
        <result property="chatCount"     column="chat_count"/>
        <result property="metadata"      column="metadata" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateTime"    column="update_time"/>
    </resultMap>

    <!-- 获取用户的分组列表（包含会话数量） -->
    <select id="selectGroupsWithChatCount" resultMap="ChatGroupVoResult">
        SELECT 
            g.group_id,
            g.user_id,
            g.group_name,
            g.parent_id,
            g.icon,
            g.color,
            g.sort_order,
            g.is_default,
            g.metadata,
            g.create_time,
            g.update_time,
            COALESCE(COUNT(c.chat_id), 0) as chat_count
        FROM sys_agent_chat_group g
        LEFT JOIN sys_agent_chat c ON g.group_id = c.group_id AND c.del_flag = '0'
        WHERE g.user_id = #{userId}
        AND g.del_flag = '0'
        GROUP BY g.group_id
        ORDER BY g.sort_order, g.create_time
    </select>

    <!-- 获取用户的默认分组 -->
    <select id="selectDefaultGroup" resultType="org.dromara.system.domain.SysAgentChatGroup">
        SELECT * FROM sys_agent_chat_group
        WHERE user_id = #{userId}
        AND is_default = '1'
        AND del_flag = '0'
        LIMIT 1
    </select>

    <!-- 批量删除分组 -->
    <update id="deleteByIds">
        UPDATE sys_agent_chat_group 
        SET del_flag = '2'
        WHERE group_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>